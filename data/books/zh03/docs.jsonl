{"doc_id": "pg_zh03_p01", "book_id": "zh03", "page_no": 1, "image_path": "data/books/zh03/pages/p01.png", "width": 1600, "height": 1600, "source_type": "pdf", "text_blocks": [], "reading_order": [], "sha256": "e0c9517c22e60ea3cf484fb1d024152d7b251601a0926cf4a381198d5a7c1ea3"}
{"doc_id": "pg_zh03_p02", "book_id": "zh03", "page_no": 2, "image_path": "data/books/zh03/pages/p02.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [60, 265, 451, 29], "text": "天鹅游，大象叫，动物园里真热闹。", "type": "body"}, {"block_id": "b02", "bbox": [58, 311, 473, 29], "text": "妈妈追着小满跑：“小满，别乱跑！”", "type": "body"}, {"block_id": "b03", "bbox": [883, 519, 659, 29], "text": "小满说：“妈妈，你又凶我。我想要一个好妈妈。”", "type": "body"}, {"block_id": "b04", "bbox": [881, 567, 485, 27], "text": "妈妈问：“你想要什么样的好妈妈？”", "type": "body"}, {"block_id": "b05", "bbox": [883, 613, 306, 27], "text": "小满说：“我想想……”", "type": "body"}, {"block_id": "b06", "bbox": [294, 747, 1083, 32], "text": "汉字源流 楷书 乱 金文 小篆 隶书 阅读指导 猜一猜，小满想要什么样的好妈妈呢？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05", "b06"], "sha256": "215a617561eab592785204964349e3b1d289c224e532c56edc67e0bff9761a56"}
{"doc_id": "pg_zh03_p03", "book_id": "zh03", "page_no": 3, "image_path": "data/books/zh03/pages/p03.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [191, 59, 392, 27], "text": "兔子！我想让兔子做我的妈妈。", "type": "body"}, {"block_id": "b02", "bbox": [191, 105, 451, 29], "text": "兔子妈妈声音小，白白身体软软毛。", "type": "body"}, {"block_id": "b03", "bbox": [191, 152, 304, 27], "text": "兔子妈妈才不会凶我呢。", "type": "body"}, {"block_id": "b04", "bbox": [950, 688, 495, 29], "text": "可是，兔子妈妈太小了。我再想想……", "type": "body"}, {"block_id": "b05", "bbox": [271, 745, 1113, 34], "text": "汉字源流 甲骨文 楷书 身 金文 小篆 隶书 阅读指导 观察一下兔子妈妈，它还有什么特点呢？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05"], "sha256": "3e19d2097a841fe7c9e0cae9855cb92f3c8f64a6cfa2184ede8f09174fc3201e"}
{"doc_id": "pg_zh03_p04", "book_id": "zh03", "page_no": 4, "image_path": "data/books/zh03/pages/p04.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [71, 57, 232, 28], "text": "大象！我想让大象", "type": "body"}, {"block_id": "b02", "bbox": [69, 103, 158, 27], "text": "做我的妈妈。", "type": "body"}, {"block_id": "b03", "bbox": [71, 549, 213, 29], "text": "大象妈妈鼻子长，", "type": "body"}, {"block_id": "b04", "bbox": [71, 596, 1396, 87], "text": "身体就像山一样。 大象妈妈一定可以保护我。 可是，大象妈妈不爱干净。我再想想……", "type": "title"}, {"block_id": "b05", "bbox": [271, 746, 1098, 34], "text": "汉字源流 甲骨文 楷书 象 金文 小篆 隶书 阅读指导 观察画面，大象妈妈在用什么洗澡？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05"], "sha256": "96b346414f72baf2c47cc72952bbe9a9b3731499cf1def20a2568aba9056af0f"}
{"doc_id": "pg_zh03_p05", "book_id": "zh03", "page_no": 5, "image_path": "data/books/zh03/pages/p05.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [72, 70, 392, 27], "text": "河马！我想让河马做我的妈妈。", "type": "body"}, {"block_id": "b02", "bbox": [72, 117, 451, 29], "text": "河马妈妈嘴巴大，水里洗澡笑开花。", "type": "body"}, {"block_id": "b03", "bbox": [72, 163, 215, 28], "text": "河马妈妈真干净。", "type": "body"}, {"block_id": "b04", "bbox": [990, 644, 494, 29], "text": "，河马妈妈抱起来好冷。我再想想……", "type": "body"}, {"block_id": "b05", "bbox": [294, 747, 1105, 33], "text": "汉字源流 楷书 河 金文 小篆 隶书 阅读指导 说一说，为什么河马妈妈抱起来冷冰冰的？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05"], "sha256": "bb4d9c5a3cdcab9793da17212d9a8389be67c009c0f02ea7da209fb53362cf67"}
{"doc_id": "pg_zh03_p06", "book_id": "zh03", "page_no": 6, "image_path": "data/books/zh03/pages/p06.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [140, 61, 391, 27], "text": "大熊！我想让大熊做我的妈妈。", "type": "body"}, {"block_id": "b02", "bbox": [140, 108, 450, 29], "text": "大熊妈妈满身毛，身体软软爱抱抱。", "type": "body"}, {"block_id": "b03", "bbox": [898, 658, 584, 29], "text": "可是，大熊妈妈冬天天天睡觉。我再想想……", "type": "body"}, {"block_id": "b04", "bbox": [317, 748, 1053, 32], "text": "汉字源流 楷书 让 小篆 隶书 阅读指导 读一读，大熊妈妈冬天会做什么事？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04"], "sha256": "ff1867e691b9691a27d8f61bbc10959cadf487ae5ed11e03ce72ec2e7182bc32"}
{"doc_id": "pg_zh03_p07", "book_id": "zh03", "page_no": 7, "image_path": "data/books/zh03/pages/p07.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [71, 45, 393, 28], "text": "企鹅！我想让企鹅做我的妈妈。", "type": "body"}, {"block_id": "b02", "bbox": [71, 92, 452, 28], "text": "企鹅妈妈黑白色，冰面滑滑玩得乐。", "type": "body"}, {"block_id": "b03", "bbox": [71, 138, 363, 29], "text": "冬天，企鹅妈妈也会和我玩。", "type": "body"}, {"block_id": "b04", "bbox": [962, 623, 304, 27], "text": "可是，企鹅妈妈只吃鱼。", "type": "body"}, {"block_id": "b05", "bbox": [961, 668, 479, 28], "text": "我还想吃面包、甜点、番茄……桃子！", "type": "body"}, {"block_id": "b06", "bbox": [271, 746, 1121, 33], "text": "汉字源流 甲骨文 楷书 冬 金文 小篆 隶书 阅读指导 观察画面，企鹅妈妈生活在什么样的地方？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05", "b06"], "sha256": "1d4c88338cffed4a236f3199de19b8ff74a50eea62c7203e7d68370a086a1b43"}
{"doc_id": "pg_zh03_p08", "book_id": "zh03", "page_no": 8, "image_path": "data/books/zh03/pages/p08.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [1000, 81, 418, 29], "text": "可是，猴子妈妈会抓乱我的头发。", "type": "body"}, {"block_id": "b02", "bbox": [1000, 127, 172, 28], "text": "我再想想……", "type": "body"}, {"block_id": "b03", "bbox": [461, 222, 233, 27], "text": "猴子！我想让猴子", "type": "body"}, {"block_id": "b04", "bbox": [460, 268, 158, 27], "text": "做我的妈妈。", "type": "body"}, {"block_id": "b05", "bbox": [48, 538, 441, 29], "text": "猴子妈妈尾巴摇，爬上爬下爱吃桃。", "type": "body"}, {"block_id": "b06", "bbox": [48, 585, 423, 28], "text": "猴子妈妈一定会给我许多好吃的。", "type": "body"}, {"block_id": "b07", "bbox": [271, 748, 1113, 32], "text": "汉字源流 甲骨文 楷书 再 金文 小篆 隶书 阅读指导 猜一猜，猴子妈妈为什么抓小满的头发？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05", "b06", "b07"], "sha256": "66b9290c89cc593abdd01e45568c1d3dfd511a363fcb236120ffefd9f74a5741"}
{"doc_id": "pg_zh03_p09", "book_id": "zh03", "page_no": 9, "image_path": "data/books/zh03/pages/p09.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [369, 90, 1115, 30], "text": "可是，天鹅妈妈嘴太尖， 天鹅！我想让天鹅", "type": "body"}, {"block_id": "b02", "bbox": [367, 136, 1148, 29], "text": "不能给我一个甜甜的亲亲。 做我的妈妈。", "type": "body"}, {"block_id": "b03", "bbox": [1180, 182, 172, 28], "text": "我再想想……", "type": "body"}, {"block_id": "b04", "bbox": [167, 621, 451, 28], "text": "天鹅妈妈水中游，梳梳毛发点点头。", "type": "body"}, {"block_id": "b05", "bbox": [167, 667, 451, 28], "text": "天鹅妈妈一定能把我的乱头发梳好。", "type": "body"}, {"block_id": "b06", "bbox": [271, 748, 1121, 32], "text": "汉字源流 甲骨文 楷书 毛 金文 小篆 隶书 阅读指导 比一比，天鹅妈妈和猴子妈妈有什么不同？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04", "b05", "b06"], "sha256": "9e834aac58f719d38419793721f6771cb2d1a51a84bfe2621fa528738464e497"}
{"doc_id": "pg_zh03_p10", "book_id": "zh03", "page_no": 10, "image_path": "data/books/zh03/pages/p10.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [907, 319, 263, 28], "text": "哪个妈妈能给我一个", "type": "body"}, {"block_id": "b02", "bbox": [907, 366, 188, 27], "text": "甜甜的亲亲呢？", "type": "body"}, {"block_id": "b03", "bbox": [294, 746, 1113, 33], "text": "汉字源流 楷书 亲 金文 小篆 隶书 阅读指导 想一想，动物妈妈们的亲亲会是什么样的呢？", "type": "body"}], "reading_order": ["b01", "b02", "b03"], "sha256": "426b83fbe493bca80ffc04988b800e58452bd1f18086bcf47186421d89add093"}
{"doc_id": "pg_zh03_p11", "book_id": "zh03", "page_no": 11, "image_path": "data/books/zh03/pages/p11.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [516, 87, 153, 25], "text": "小满的妈妈！", "type": "body"}, {"block_id": "b02", "bbox": [1050, 681, 300, 28], "text": "小满的妈妈什么都会做！", "type": "body"}, {"block_id": "b03", "bbox": [317, 747, 1061, 32], "text": "汉字源流 楷书 体 小篆 隶书 阅读指导 说一说，你的妈妈为你做过哪些事呢？", "type": "body"}], "reading_order": ["b01", "b02", "b03"], "sha256": "ae672eca70998c76fd477d116af23af36730a5e6cb639d8ac73c58b3496adf8f"}
{"doc_id": "pg_zh03_p12", "book_id": "zh03", "page_no": 12, "image_path": "data/books/zh03/pages/p12.png", "width": 1600, "height": 800, "source_type": "pdf", "text_blocks": [{"block_id": "b01", "bbox": [942, 103, 530, 29], "text": "“你就是最好的妈妈！抱抱我的好妈妈。”", "type": "body"}, {"block_id": "b02", "bbox": [203, 580, 412, 29], "text": "“妈妈，我知道谁是好妈妈了。”", "type": "body"}, {"block_id": "b03", "bbox": [203, 627, 147, 27], "text": "“是谁呢？”", "type": "body"}, {"block_id": "b04", "bbox": [317, 747, 1075, 33], "text": "汉字源流 小篆 隶书 抱 楷书 阅读指导 说一说，你觉得哪个妈妈最好呢？为什么？", "type": "body"}], "reading_order": ["b01", "b02", "b03", "b04"], "sha256": "5220a3bb63f619ccb79d737b4156adbf9d74b8f7ea5ae035c86b7a54ae70e3f9"}
